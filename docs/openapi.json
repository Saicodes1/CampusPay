              },
              {
                "type": "null"
              }
            ],
            "title": "Qrimage"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "amount",
          "currency"
        ],
        "title": "OperationResult"
      },
      "Purchase": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Product Id"
          },
          "expected_amount": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Expected Amount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "expected_amount"
        ],
        "title": "Purchase"
      },
      "Transfer": {
        "properties": {
