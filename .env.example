# Local demo credentials. Never use for real funds or public deployments.
CAMPUSPAY_DEMO_PASSWORD=campuspay-demo-only
CAMPUSPAY_WEBHOOK_SECRET=campuspay-webhook-demo-only-32chars
# For uv-run API/worker on your host; Compose overrides infrastructure addresses.
CAMPUSPAY_DATABASE_URL=postgresql://campuspay:campuspay-local-only@127.0.0.1:55432/campuspay
CAMPUSPAY_REDIS_URL=redis://127.0.0.1:56379/0
CAMPUSPAY_RABBIT_URL=amqp://campuspay:campuspay-local-only@127.0.0.1:5673/%2F
CAMPUSPAY_WEBHOOK_URL=http://127.0.0.1:8090/events
